# Ghostty Configuration - Ayu Dark Theme
# Synced via dotfiles repo

# Font Configuration
font-family = Google Sans Code NF
font-size = 18

# Shell Configuration
shell-integration = bash
command = /bin/bash -l

# Ayu Dark Theme Colors
background = #0A0E14
foreground = #B3B1AD

# Cursor Colors
cursor-color = #B3B1AD
cursor-text = #0A0E14

# Selection Colors
selection-background = #253340
selection-foreground = #B3B1AD

# Normal Colors (0-7)
palette = 0=#01060E
palette = 1=#EA6C73
palette = 2=#91B362
palette = 3=#F9AF4F
palette = 4=#53BDFA
palette = 5=#FAE994
palette = 6=#90E1C6
palette = 7=#C7C7C7

# Bright Colors (8-15)
palette = 8=#686868
palette = 9=#F07178
palette = 10=#C2D94C
palette = 11=#FFB454
palette = 12=#59C2FF
palette = 13=#FFEE99
palette = 14=#95E6CB
palette = 15=#FFFFFF

# Window Configuration
window-padding-x = 10
window-padding-y = 5
window-decoration = false
window-theme = dark

# Performance
macos-option-as-alt = true
