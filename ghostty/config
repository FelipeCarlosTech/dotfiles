# Ghostty Configuration - Ayu Dark Theme
# Synced via dotfiles repo

# Font Configuration
font-family = Google Sans Code NF
font-size = 15

# Shell Configuration
shell-integration = bash
command = /opt/homebrew/bin/bash

# Ayu Dark Theme Colors
background = #0A0E14
foreground = #B3B1AD

# Cursor Colors (Ayu Dark Yellow for trail effect)
cursor-color = #FFB454
cursor-text = #0A0E14

# Cursor Shape & Blink
# Bloque grueso (no la rayita delgada) + parpadeo activado.
cursor-style = block
# Blink nativo OFF: el shader 9-smearbreathe genera su propio blink sincronizado
# con el breathe. Si usas otro efecto y quieres parpadeo, ponlo en true.
cursor-style-blink = false
# Evita que bash/programas cambien la forma del cursor a barra.
shell-integration-features = no-cursor

# Cursor FX — shader activo seleccionable con el comando `cfx` (ej: cfx bloom).
# active_cursor.glsl es un symlink a uno de shaders/effects/*.glsl
custom-shader = shaders/active_cursor.glsl
# Anima siempre: necesario para los fades/pulsos de los efectos.
custom-shader-animation = always

# Selection Colors
selection-background = #253340
selection-foreground = #B3B1AD

# Normal Colors (0-7)
palette = 0=#01060E
palette = 1=#EA6C73
palette = 2=#91B362
palette = 3=#F9AF4F
palette = 4=#53BDFA
palette = 5=#FAE994
palette = 6=#90E1C6
palette = 7=#C7C7C7

# Bright Colors (8-15)
palette = 8=#686868
palette = 9=#F07178
palette = 10=#C2D94C
palette = 11=#FFB454
palette = 12=#59C2FF
palette = 13=#FFEE99
palette = 14=#95E6CB
palette = 15=#FFFFFF

# Window Configuration
window-padding-x = 10
window-padding-y = 5
window-decoration = true
window-theme = dark

# Window size (centered rectangle, wider than tall)
window-width = 180
window-height = 45

# Performance
macos-option-as-alt = true

# ============================================================
# Keybindings — Setup Ghostty-only (reemplazo de Zellij)
# ============================================================
# Splits (paneles) — cmd+d nuevo split derecha, cmd+shift+d abajo
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
# Navegación entre splits estilo vim (hjkl)
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right
# Zoom (fullscreen del split activo) y cerrar
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+w=close_surface
# Igualar tamaño de todos los splits
keybind = cmd+ctrl+r=equalize_splits

# Tabs (pestañas)
keybind = cmd+t=new_tab
keybind = cmd+shift+l=next_tab
keybind = cmd+shift+h=previous_tab
# (cmd+1..9 para saltar a una pestaña ya viene por defecto en Ghostty)

# Nota: ya no hace falta desvincular alt+hjkl/arrows (eran para Zellij);
# así alt queda libre para mover palabras en bash/readline.
