# Ghostty Configuration - Ayu Dark Theme
# Synced via dotfiles repo

# Font Configuration
font-family = Google Sans Code NF
font-size = 15

# Shell Configuration
shell-integration = bash
command = /opt/homebrew/bin/bash

# Ayu Dark Theme Colors
background = #0A0E14
foreground = #B3B1AD

# Cursor Colors (Ayu Dark Yellow for trail effect)
cursor-color = #FFB454
cursor-text = #0A0E14

# Cursor Trail Effect (shader personalizado)
custom-shader = shaders/cursor_trail.glsl

# Selection Colors
selection-background = #253340
selection-foreground = #B3B1AD

# Normal Colors (0-7)
palette = 0=#01060E
palette = 1=#EA6C73
palette = 2=#91B362
palette = 3=#F9AF4F
palette = 4=#53BDFA
palette = 5=#FAE994
palette = 6=#90E1C6
palette = 7=#C7C7C7

# Bright Colors (8-15)
palette = 8=#686868
palette = 9=#F07178
palette = 10=#C2D94C
palette = 11=#FFB454
palette = 12=#59C2FF
palette = 13=#FFEE99
palette = 14=#95E6CB
palette = 15=#FFFFFF

# Window Configuration
window-padding-x = 10
window-padding-y = 5
window-decoration = true
window-theme = dark

# Window size (centered rectangle, wider than tall)
window-width = 180
window-height = 45

# Performance
macos-option-as-alt = true

# Keybindings - Unbind Alt combinations that conflict with Zellij (keep Cmd shortcuts)
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+up=unbind
keybind = alt+down=unbind
keybind = alt+f=unbind
keybind = alt+n=unbind
